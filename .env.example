# Copy to .env and fill in. docker compose reads .env from this directory.

# Required: password for the /admin UI.
# NOTE on special characters: docker compose / .env do their own parsing, so a
# complex password can be mangled before the app sees it. Wrap the value in
# single quotes, and remember a literal `$` must be doubled as `$$` (compose
# treats `$` as variable interpolation). Avoid a leading/trailing space.
# Example: ADMIN_PASSWORD='my-$$tr0ng!p@ss'
ADMIN_PASSWORD=change-me

# Optional: secret for signing session cookies. If unset, ctrlcenter generates
# a random one on first start and keeps it in the config volume
# (config/session-secret). Set it to manage the secret yourself.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=
